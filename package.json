{
  "name": "awulubo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "一个要你喂的小怪物：喂它苹果、小鱼、黄星星，它就变成那个颜色，还会打嗝喷彩纸、跟你躲猫猫、数给你看。3–5 岁能自己翻自己点，屏幕里会叫，纸上也能玩 ｜ A hungry blob monster you feed, pat, hide and seek with, and count with.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "node tools/clean.mjs",
    "preview": "vite preview",
    "fonts": "node tools/build-fonts.mjs",
    "fx": "python tools/gen-effects.py",
    "check": "node tools/build-fonts.mjs --check && node tools/check-pages.mjs --full && node tools/check-layout.mjs && node tools/check-licenses.mjs && python tools/check-text.py",
    "check:shots": "python tools/check-shots.py",
    "check:contrast": "node tools/check-contrast.mjs",
    "shots": "node tools/shots.mjs",
    "shots:print": "node tools/shots.mjs --print",
    "smoke": "node tools/smoke.mjs",
    "chaos": "node tools/chaos.mjs",
    "pdf": "node tools/pdf.mjs",
    "pdf:booklet": "node tools/pdf-booklet.mjs"
  },
  "devDependencies": {
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "handlebars": "^4.7.10",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
