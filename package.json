{
  "name": "awulubo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "3–5 岁自己翻自己点的绘本：喂它苹果、小鱼、黄星星，它就变成那个颜色。离线，不注册。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "site": "node tools/site-files.mjs",
    "clean": "node tools/clean.mjs",
    "preview": "vite preview",
    "fonts": "node tools/build-fonts.mjs",
    "fx": "python tools/gen-effects.py",
    "check": "npm run typecheck && node tools/build-fonts.mjs --check && node tools/check-pages.mjs --full && node tools/audit-content.mjs && node tools/check-age-language.mjs && node tools/check-interaction-density.mjs && node tools/check-spread-palette.mjs && node tools/check-hotspots.mjs && node tools/check-layout.mjs && node tools/check-licenses.mjs && python tools/check-text.py",
    "check:shots": "python tools/check-shots.py",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:publish": "node tools/check-publish.mjs",
    "shots": "node tools/shots.mjs",
    "shots:print": "node tools/shots.mjs --print",
    "smoke": "node tools/smoke.mjs",
    "chaos": "node tools/chaos.mjs",
    "pdf": "node tools/pdf.mjs",
    "pdf:booklet": "node tools/pdf-booklet.mjs",
    "og": "node tools/make-brand.mjs --card",
    "logo": "node tools/make-brand.mjs --logo",
    "brand": "node tools/make-brand.mjs --all",
    "shots:readme": "node tools/readme-shots.mjs && python tools/readme-compose.py",
    "check:palette": "node tools/check-spread-palette.mjs",
    "check:repeat": "node tools/check-spread-repeat.mjs",
    "verify:teeth": "node tools/verify-teeth.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "verify:reader": "node tools/verify-reader.mjs"
  },
  "devDependencies": {
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "handlebars": "^4.7.10",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
